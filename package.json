{
  "name": "ghostty-xterm-bench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Ghostty embedded headlessly in Electron: ghostty owns PTY, parsing, fonts, Metal rendering — frames enter the DOM zero-copy via sharedTexture. Plus DOM-terminal benchmarks (xterm.js, ghostty-web).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "payload": "node scripts/gen-payload.js",
    "setup:ghostty": "bash scripts/setup-ghostty.sh",
    "build:native": "cd packages/electron-ghostty && node-gyp rebuild",
    "bench": "node bench/run.js flood",
    "demo": "electron demo-ghostty-renderer/main.js",
    "demo:gif": "electron demo-ghostty-renderer/main.js --record-gif",
    "test": "node --test test/embedded.test.js",
    "test:integration": "node --test test/integration.test.js",
    "bench:stock": "node scripts/bench-stock.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@xterm/addon-fit": "^0.12.0-beta.288",
    "@xterm/addon-webgl": "^0.19.0-beta.288",
    "@xterm/headless": "^6.1.0-beta.288",
    "@xterm/xterm": "^6.1.0-beta.288",
    "electron": "42.5.0",
    "ghostty-web": "^0.4.0",
    "node-gyp": "^11.0.0",
    "node-pty": "^1.1.0"
  }
}

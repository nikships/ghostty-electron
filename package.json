{
  "name": "ghostty-xterm-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark: cat a 1MB file in Electron — xterm.js (WebGL, in-renderer) vs libghostty + native IOSurface producer via Electron sharedTexture",
  "scripts": {
    "payload": "node scripts/gen-payload.js",
    "setup:ghostty": "bash scripts/setup-ghostty.sh",
    "build:native": "cd native && node-gyp rebuild",
    "bench:xterm": "electron xterm-bench/main.js",
    "bench:ghostty": "electron ghostty-bench/main.js",
    "bench": "node bench.js"
  },
  "devDependencies": {
    "@xterm/addon-webgl": "^0.19.0-beta.288",
    "@xterm/xterm": "^6.1.0-beta.288",
    "electron": "42.5.0",
    "node-gyp": "^11.0.0"
  }
}

+    /// The last presented frame of a headless surface.
+    /// C type: ghostty_headless_frame_s
+    const HeadlessFrame = extern struct {
+        /// IOSurfaceRef of the last presented frame, retained (+1);
+        /// the caller must CFRelease it. Null if no frame has been
+        /// presented yet or this isn't a Darwin build.
+        iosurface: ?*anyopaque,
+        width_px: u32,
+        height_px: u32,
+        scale: f64,
+    };
+
+    /// Returns the last presented frame of a headless surface. Only
+    /// meaningful for surfaces created with the headless platform tag,
+    /// but safe to call on any surface (frames are presented to the
+    /// same layer in all cases).
+    ///
+    /// The frame is the renderer's most recently presented render
+    /// target. Ghostty triple-buffers, so the returned IOSurface will
+    /// not be drawn into again until two more frames are presented;
+    /// callers that need the pixels for longer should copy or import
+    /// the surface promptly. Call ghostty_surface_draw() first to force
+    /// a synchronous present of any pending frame.
+    export fn ghostty_surface_headless_frame(surface: *Surface) HeadlessFrame {
+        if (comptime builtin.target.os.tag.isDarwin()) {
+            const layer = surface.core_surface.renderer.api.layer.layer;
+            const contents = layer.getProperty(?*anyopaque, "contents");
+            if (contents) |ptr| {
+                // Retain for the caller. The layer holds its own
+                // reference; ours guarantees validity after the layer
+                // moves on.
+                const CFRetain = @extern(
+                    *const fn (?*anyopaque) callconv(.c) ?*anyopaque,
+                    .{ .name = "CFRetain" },
+                );
+                _ = CFRetain(ptr);
+            }
+            const scale = layer.getProperty(f64, "contentsScale");
+            const bounds = layer.getProperty(graphics.Rect, "bounds");
+            return .{
+                .iosurface = contents,
+                .width_px = @intFromFloat(@round(bounds.size.width * scale)),
+                .height_px = @intFromFloat(@round(bounds.size.height * scale)),
+                .scale = scale,
+            };
+        } else return .{
+            .iosurface = null,
+            .width_px = 0,
+            .height_px = 0,
+            .scale = 1,
+        };
+    }
+
     /// Update the size of a surface. This will trigger resize notifications
     /// to the pty and the renderer.
     export fn ghostty_surface_set_size(surface: *Surface, w: u32, h: u32) void {

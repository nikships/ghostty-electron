 } ghostty_platform_e;
 
 typedef enum {
@@ -457,11 +458,29 @@ typedef struct {
   void* uiview;
 } ghostty_platform_ios_s;
 
+// No native view: the renderer draws into offscreen targets
+// (IOSurfaces on macOS) that the embedder reads back via
+// ghostty_surface_headless_frame().
+typedef struct {
+  void* reserved;
+} ghostty_platform_headless_s;
+
 typedef union {
   ghostty_platform_macos_s macos;
   ghostty_platform_ios_s ios;
+  ghostty_platform_headless_s headless;
 } ghostty_platform_u;
 
+// The last presented frame of a headless surface. The iosurface is an
+// IOSurfaceRef retained on behalf of the caller (CFRelease when done),
+// or NULL if no frame has been presented yet.
+typedef struct {
+  void* iosurface;
+  uint32_t width_px;
+  uint32_t height_px;
+  double scale;
+} ghostty_headless_frame_s;
+
 typedef enum {
   GHOSTTY_SURFACE_CONTEXT_WINDOW = 0,
   GHOSTTY_SURFACE_CONTEXT_TAB = 1,
@@ -1135,6 +1154,8 @@ GHOSTTY_API bool ghostty_surface_needs_confirm_quit(ghostty_surface_t);
 GHOSTTY_API bool ghostty_surface_process_exited(ghostty_surface_t);
 GHOSTTY_API void ghostty_surface_refresh(ghostty_surface_t);
 GHOSTTY_API void ghostty_surface_draw(ghostty_surface_t);
+GHOSTTY_API ghostty_headless_frame_s
+ghostty_surface_headless_frame(ghostty_surface_t);
